/dist
/.angular
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log*
yarn-error.log
yarn-debug.log*
pnpm-debug.log*

# IDEs and editors
.idea/
*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*
.vscode
# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Environment files and sensitive credentials
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.production.local

# Test / coverage tools
.nyc_output/

# Build/tool caches
.cache/

# Runtime debug / pid files
.pids/
*.pid

# Logs
*.log

# Workspace and temporary OS files
*.swp
*.swo
*.tmp
*.sln
*.slnx
*.sw?
*.suo
*.njsproj
*.ntvs
# Other
__screenshots__/
